# System Configuration
LOG_PATH=/var/log/raspi_scam_alerts.log
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Model Configuration
TEXT_MODEL_EN=distilbert-base-uncased
DEVICE=cpu
ALERT_THRESHOLD_PERCENT=70
